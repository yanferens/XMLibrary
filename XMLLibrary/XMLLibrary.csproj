<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only: Google sign-in uses a loopback redirect, and the app is designed and tested for Windows. -->
		<TargetFrameworks>net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>XMLLibrary</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>XMLLibrary</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.knu.xmllibrary</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- An unpackaged Windows app: it runs as an ordinary .exe, without an MSIX installer. -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F5B544" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F5B544" BaseSize="128,128" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix): client_secret.json goes here -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Google.Apis.Drive.v3" Version="1.77.0.4301" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XMLLibrary.Core\XMLLibrary.Core.csproj" />
	</ItemGroup>

</Project>
