<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The whole visual language of the app lives here: one dark "ink and amber" palette and the styles
    built on it. The page only refers to these names, so the look can be changed in one place.
-->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XMLLibrary.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═════════════ Palette ═════════════ -->
            <Color x:Key="Background">#0B0D12</Color>
            <Color x:Key="SidebarBackground">#0F121A</Color>
            <Color x:Key="Surface">#151A24</Color>
            <Color x:Key="SurfaceRaised">#1C2230</Color>
            <Color x:Key="SurfaceHover">#252D3E</Color>
            <Color x:Key="Line">#273042</Color>
            <Color x:Key="TextPrimary">#ECEFF5</Color>
            <Color x:Key="TextMuted">#8B95A8</Color>
            <Color x:Key="TextFaint">#5D667A</Color>
            <Color x:Key="Accent">#F5B544</Color>
            <Color x:Key="AccentHover">#FFC967</Color>
            <Color x:Key="AccentDeep">#E07B39</Color>
            <Color x:Key="AccentSoft">#2A2416</Color>
            <Color x:Key="OnAccent">#1B1406</Color>
            <Color x:Key="Violet">#8EA2FF</Color>
            <Color x:Key="VioletSoft">#1F2540</Color>
            <Color x:Key="OnViolet">#10132A</Color>
            <Color x:Key="Mint">#3DD68C</Color>
            <Color x:Key="MintSoft">#13291F</Color>
            <Color x:Key="Danger">#FF6B6B</Color>
            <Color x:Key="DangerSoft">#2E1A1D</Color>
            <Color x:Key="DangerLine">#5A2A30</Color>
            <Color x:Key="DisabledBackground">#161A22</Color>
            <Color x:Key="DisabledText">#4A5264</Color>
            <!-- #AARRGGBB: a dark veil behind the dialogs of the page -->
            <Color x:Key="Backdrop">#E6050709</Color>

            <SolidColorBrush x:Key="LineBrush" Color="#273042" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F5B544" />

            <!-- ═════════════ Text ═════════════ -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Small capitals above the sections: "ДЖЕРЕЛА ДАНИХ" -->
            <Style x:Key="SectionCaption" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextFaint}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
            </Style>

            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- ═════════════ Buttons ═════════════ -->
            <!-- The base of every button: size, corners and the disabled look. -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinimumHeightRequest" Value="40" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
            </Style>

            <!-- The main action: amber, dark text. -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource DisabledBackground}" />
                                    <Setter Property="TextColor" Value="{StaticResource DisabledText}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- A filled secondary action. -->
            <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource DisabledBackground}" />
                                    <Setter Property="TextColor" Value="{StaticResource DisabledText}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- An outlined action without a fill. -->
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderColor" Value="{StaticResource Line}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource DisabledText}" />
                                    <Setter Property="BorderColor" Value="{StaticResource DisabledBackground}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- Leaving the program: red text, red line. -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                <Setter Property="BorderColor" Value="{StaticResource DangerLine}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- ═════════════ Inputs ═════════════ -->
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextFaint}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- ═════════════ Surfaces ═════════════ -->
            <!-- A large rounded panel. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <!-- A smaller panel inside the left column. -->
            <Style x:Key="SourceCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="Stroke" Value="{StaticResource LineBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <!-- A small coloured label such as "XML" or "8 книг". -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 7" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
